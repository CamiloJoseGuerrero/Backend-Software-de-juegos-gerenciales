# Copia este archivo como .env y llena los valores reales.
# El .env NUNCA se sube a git (ya esta en .gitignore).

# --- Base de datos (Neon) ---
DB_URL=jdbc:postgresql://<host>.neon.tech/<base>?sslmode=require
DB_USERNAME=<usuario>
DB_PASSWORD=<contrasena>
DDL_AUTO=validate
SHOW_SQL=false

# --- Seguridad (OBLIGATORIO: cadena larga y aleatoria, minimo 32 caracteres) ---
JWT_SECRET=<secreto-largo-aleatorio>
JWT_EXPIRATION=86400000

# --- Frontend / CORS ---
FRONTEND_URL=http://localhost:4200
CORS_ALLOWED_ORIGINS=http://localhost:4200
APP_ZONA_HORARIA=America/Bogota

# --- Correo (con false no se envian correos) ---
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=<correo@gmail.com>
MAIL_PASSWORD=<contrasena-de-aplicacion>
MAIL_FROM=<correo@gmail.com>
